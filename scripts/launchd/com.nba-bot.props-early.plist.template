<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nba-bot.props-early</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/run_phase.sh</string>
        <string>props-early</string>
    </array>
    <!-- Late morning: prices props for games tipping in the next ~4 hours (weekend
         and holiday matinees) that the main 14:30 run would be too late for. A no-op
         on a normal evening slate. Hour is LOCAL machine time (defaults assume PT). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd.props-early.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd.props-early.err</string>
</dict>
</plist>
