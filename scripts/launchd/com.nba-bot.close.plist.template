<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nba-bot.close</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/run_phase.sh</string>
        <string>close</string>
    </array>
    <!-- Near tip, twice: before the ~4pm PT eastern tips and before the ~7pm PT
         western ones. The last pre-tip snapshot of each game becomes its CLOSING
         price, which every bet's CLV is measured against. MUST run after the bets or
         CLV collapses to ~0. Cheap: one request for game lines, and props re-price
         only the markets we hold. Hour is LOCAL machine time (defaults assume PT). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd.close.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd.close.err</string>
</dict>
</plist>
