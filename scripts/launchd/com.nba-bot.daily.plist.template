<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nba-bot.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/run_phase.sh</string>
        <string>daily</string>
    </array>
    <!-- Mid-afternoon: ~90 min before the first evening tips (~4pm PT). The whole
         day in one run: settles what finished, reads injuries and news, predicts
         tonight's games, chooses the picks at current prices, and sends the text.
         Hour is LOCAL machine time (defaults assume PT). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>14</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd.daily.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd.daily.err</string>
</dict>
</plist>
