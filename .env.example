# Postgres — read by BOTH docker-compose.yml and the app (config.py builds
# DATABASE_URL from these). Generate a password with: openssl rand -hex 24
POSTGRES_USER=nba_app
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_DB=nba_bot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Claude API - https://console.anthropic.com/
ANTHROPIC_API_KEY=KEY

# Odds API - https://the-odds-api.com/ (free tier: 500 requests/month)
ODDS_API_KEY=KEY

# Voyage AI embeddings, used for news RAG - https://www.voyageai.com/ (free tier available)
VOYAGE_API_KEY=KEY

# Model selection
ANALYSIS_MODEL=claude-sonnet-5
EMBEDDING_MODEL=voyage-3

# --- Player props + news signals -------------------------------------------
# Model that reads the day's news into player signals (minutes limits, role
# changes). Haiku costs about a cent a day; claude-opus-5-5 catches more of the
# absences on its own but costs ~40x as much.
NEWS_MODEL=claude-haiku-5-5
# Prop markets to price (comma-separated Odds API keys). Each costs one Odds API
# credit per game per snapshot, so trim this to fit your plan.
# PROP_MARKETS=player_points,player_rebounds,player_assists,player_points_rebounds_assists
# Stop buying prop snapshots when the Odds API quota falls to this many credits.
ODDS_QUOTA_RESERVE=50

# --- Notifications ----------------------------------------------------------
# Comma-separated: imessage (a real text via this Mac's Messages app) and/or ntfy
# (push notification via ntfy.sh). Empty = digests are only written to logs/.
NOTIFY_CHANNELS=
# Your own phone number (+15551234567) or Apple ID email.
NOTIFY_IMESSAGE_TO=
# An unguessable topic name; subscribe to it in the ntfy phone app.
NOTIFY_NTFY_TOPIC=
# Optional: your bankroll in dollars, to show stakes as $ as well as units.
BANKROLL=0
# Also text the morning-after results (they are always written to logs/).
NOTIFY_RESULTS=false
