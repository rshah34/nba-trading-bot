# Postgres — read by BOTH docker-compose.yml and the app (config.py builds
# DATABASE_URL from these). Generate a password with: openssl rand -hex 24
POSTGRES_USER=nba_app
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_DB=nba_bot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Claude API - https://console.anthropic.com/
ANTHROPIC_API_KEY=KEY

# Odds API - https://the-odds-api.com/ (free tier: 500 requests/month)
ODDS_API_KEY=KEY

# Model selection
ANALYSIS_MODEL=claude-sonnet-5

# --- Player props + news signals -------------------------------------------
# Model that reads the day's news into player signals (minutes limits, role
# changes). Haiku costs about a cent a day; claude-opus-5-5 catches more of the
# absences on its own but costs ~40x as much.
NEWS_MODEL=claude-haiku-5-5
# Prop markets to price (comma-separated Odds API keys). Each costs one Odds API
# credit per game per snapshot. The free plan (500/month) fits ONE market plus
# moneyline-only game lines; unset both lines below to price all 12 on a paid plan.
# Keys: player_points, player_rebounds, player_assists, player_threes, player_steals,
# player_blocks, player_turnovers, player_points_rebounds_assists,
# player_points_rebounds, player_points_assists, player_rebounds_assists,
# player_blocks_steals
PROP_MARKETS=player_points_rebounds_assists
# Game-line markets per snapshot (h2h = moneyline, spreads, totals); one credit each.
GAME_MARKETS=h2h
# Books whose prices are bought (they set the market consensus). Up to ten cost the
# same credits as one region; keys are The Odds API's bookmaker keys.
ODDS_BOOKMAKERS=draftkings,hardrockbet,kalshi,fanduel,betmgm,betrivers,espnbet,bovada,betonlineag
# The books you can actually bet at: picks are only made at one of their prices.
MY_BOOKS=
# Stop buying prop snapshots when the Odds API quota falls to this many credits.
ODDS_QUOTA_RESERVE=50
# Day of the month your Odds API quota refills.
ODDS_QUOTA_RESET_DAY=1

# The most bets (game winners + props together) recorded and texted per day.
MAX_DAILY_BETS=3

# --- Notifications ----------------------------------------------------------
# Your own phone number (+15551234567) or Apple ID email. The best-bets text is
# sent to it through this Mac's Messages app. Empty = digests only go to logs/.
NOTIFY_IMESSAGE_TO=

